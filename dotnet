#!/usr/bin/env bash
set -euo pipefail

SDK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.dotnet"
ICU_LIB="$SDK_ROOT/icu/usr/lib/x86_64-linux-gnu"
CLI_HOME="$SDK_ROOT/cli-home"
NUGET_PACKAGES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.nuget/packages"

export DOTNET_ROOT="$SDK_ROOT"
export LD_LIBRARY_PATH="$ICU_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export DOTNET_CLI_HOME="$CLI_HOME"
export NUGET_PACKAGES
export DOTNET_NOLOGO=1
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

exec "$SDK_ROOT/dotnet" "$@"
